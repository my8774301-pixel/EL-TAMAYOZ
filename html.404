<!doctype html>
<html>
  <head>
    <meta charset="utf-8" />
    <script>
      const path = window.location.pathname;
      const repo = "/EL-TAMAYOZ";

      if (path.startsWith(repo)) {
        const rest = path.slice(repo.length);
        window.location.replace(
          repo + "/?redirect=" + encodeURIComponent(rest + window.location.search + window.location.hash)
        );
      } else {
        window.location.replace("/");
      }
    </script>
  </head>
  <body></body>
</html>
